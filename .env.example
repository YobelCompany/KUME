# =========================================================
# KUME 환경변수 예시
# 실제 값을 채운 뒤 파일명을 `.env.local`로 저장하세요.
# `.env.local`은 .gitignore에 포함되어 커밋되지 않습니다.
# =========================================================

# 사이트 공개 URL (OG 이미지 · sitemap 등에서 사용)
NEXT_PUBLIC_SITE_URL="https://kume.kr"

# ---------------------------------------------------------
# 얼리버드 폼 저장소 (아래 두 옵션 중 하나만 설정하세요)
# ---------------------------------------------------------

# --- 옵션 A · Google Form ---
# 1) Google Forms에서 폼을 만들고 "미리보기"로 진입
# 2) 개발자 도구 → 각 input의 name 속성 (entry.XXXXXXXXX) 확인
# 3) form의 action 속성이 아래 URL 패턴입니다.
#GOOGLE_FORM_ACTION_URL="https://docs.google.com/forms/d/e/FORM_ID/formResponse"
#GOOGLE_FORM_NAME_ENTRY="entry.1111111111"
#GOOGLE_FORM_EMAIL_ENTRY="entry.2222222222"
#GOOGLE_FORM_MESSAGE_ENTRY="entry.3333333333"    # 선택

# --- 옵션 B · Airtable ---
# 1) https://airtable.com/create/tokens 에서 Personal Access Token 발급
#    Scopes: data.records:write / Access: 해당 base
# 2) Base ID: airtable.com에서 base 열고 URL의 appXXXXXX...
# 3) Table name: 실제 테이블 이름 (예: Earlybird)
# 4) 필드명이 다르면 아래 FIELD_* 도 지정 (기본 Name/Email/Message)
#AIRTABLE_API_KEY="patXXXXXXXXXXXXXX"
#AIRTABLE_BASE_ID="appXXXXXXXXXXXXXX"
#AIRTABLE_TABLE_NAME="Earlybird"
#AIRTABLE_FIELD_NAME="Name"
#AIRTABLE_FIELD_EMAIL="Email"
#AIRTABLE_FIELD_MESSAGE="Message"
